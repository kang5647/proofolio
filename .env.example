# ProofDesk — names only. Copy to .env and fill. Never commit .env.
# --- local services ---
SOURCE_PORT=4100
SOURCE_ADMIN_TOKEN=
SOURCE_DEV_TOKEN=
VERIFIER_PORT=4200
BUYER_PORT=4300
DATA_DIR=./data
LOG_LEVEL=info
# --- Ethereum (Sepolia consumer: ResumeReceipt) ---
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
RESUME_RECEIPT_ADDRESS=
# local anvil fallback (chain id 31337)
ANVIL_RPC_URL=http://127.0.0.1:8545
# --- Chainlink CRE ---
CRE_BIN=~/.cre/bin/cre
CRE_TARGET=staging-settings
# EXECUTION_ENGINE: cre-simulate | in-process-fallback
EXECUTION_ENGINE=cre-simulate
# --- Masumi / Cardano Preprod ---
MASUMI_PAYMENT_SERVICE_URL=http://127.0.0.1:3001/api/v1
MASUMI_PAYMENT_API_KEY=
MASUMI_AGENT_IDENTIFIER=
MASUMI_SELLER_VKEY=
MASUMI_NETWORK=Preprod
# PAYMENT_MODE: masumi | mock  (mock is for local development only and is labelled as such)
PAYMENT_MODE=mock
BLOCKFROST_API_KEY_PREPROD=
# buyer spend cap in tUSDM atomic units (6 decimals); 2 jobs x 1 tUSDM = 2000000
BUYER_TOTAL_SPEND_CAP=2000000
# --- optional LLM for explanations only ---
ANTHROPIC_API_KEY=
