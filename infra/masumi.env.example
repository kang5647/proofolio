# Masumi Payment Service runtime env (copy to vendor/masumi.env; gitignored). Names only.
ENCRYPTION_KEY=
ADMIN_KEY=
BLOCKFROST_API_KEY_PREPROD=
PORT=3001
SEED_ONLY_IF_EMPTY=True
AUTO_WITHDRAW_PAYMENTS=true
AUTO_WITHDRAW_REFUNDS=true
BLOCK_CONFIRMATIONS_THRESHOLD=20
BATCH_PAYMENT_INTERVAL=120
CHECK_TX_INTERVAL=90
CHECK_COLLECTION_INTERVAL=120
CHECK_SUBMIT_RESULT_INTERVAL=120
REGISTER_AGENT_INTERVAL=120
